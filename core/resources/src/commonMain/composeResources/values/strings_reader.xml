    <string name="reader_missing_title">This link is gone</string>
    <string name="reader_missing_body">It was removed from Stash, so there is nothing to open.</string>
    <!-- Detail pane on wide screens before an item is picked. -->
    <string name="reader_empty_title">Nothing open yet</string>
    <string name="reader_empty_body">Pick a link from your shelf to read it here.</string>
    <!-- A change could not be saved (storage failure). -->
    <string name="reader_action_failed">That didn’t save. Try again.</string>
