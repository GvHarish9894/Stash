    <!-- Handoff: "Reader mode can't extract text". -->
    <string name="reader_unavailable">Reader mode isn’t available for this page.</string>
    <!-- Handoff offline copy, split into the message's title and body. -->
    <string name="reader_offline_title">You’re offline.</string>
    <string name="reader_offline_body">This page will open when you’re back online.</string>
    <!-- Button under the offline message of the web page; opens the link in the browser. -->
    <string name="reader_open_in_browser">Open in browser</string>
