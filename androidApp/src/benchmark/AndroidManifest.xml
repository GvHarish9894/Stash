<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Lets Macrobenchmark and simpleperf profile this non-debuggable build. -->
        <profileable android:shell="true" />

        <!-- Measurement data only; never in release. Exported so the shell can reach it, but only a holder of DUMP
             (the shell, not an app) may send to it. -->
        <receiver
            android:name="com.techgv.stash.SeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.techgv.stash.SEED" />
                <action android:name="com.techgv.stash.WIPE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
